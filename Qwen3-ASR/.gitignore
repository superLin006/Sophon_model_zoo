models/*.safetensors
models/BM1684X/*.bmodel
models/README.md

# 编译中间产物
compile/tmp/

# 运行时 dump
python/dump/

# 交叉编译产物
cpp/build/

# Python
__pycache__/
*.pyc
# W4F16 实验生成物
compile/*.json
